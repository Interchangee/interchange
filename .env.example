# ============================================================================
#  Optional: bake the Supabase connection into the app at build time.
#
#  The anon (publishable) key is designed to be public - every table is guarded
#  by Row Level Security, so shipping it in the bundle is fine. NEVER put the
#  service_role key here.
#
#  Two ways to use this file:
#
#  1. Hosts with build steps (Vercel, Netlify, Cloudflare Pages, GitHub Actions)
#     set these as project/environment variables in their dashboard, then run:
#
#         npm run build          # writes assets/js/config.local.js
#
#     assets/js/config.local.js overrides the empty defaults in config.js, so
#     visitors never see the "Connect to Supabase" screen.
#
#  2. Local development: copy this file to .env, fill it in, run
#     `npm run build` once. .env and config.local.js are git-ignored.
#
#  If you skip all of this, the app simply shows its setup screen on first
#  launch and stores the values in that browser only.
# ============================================================================

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
