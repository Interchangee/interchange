{
  "name": "Interchange",
  "short_name": "Interchange",
  "description": "An in-real-life transit game: GPS tracking, automatic stop matching from OpenStreetMap and free GTFS feeds, plus flexible points.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f5822a",
